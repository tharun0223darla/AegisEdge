# ------------------------------------------------------------
# MediTrack AI - Environment Variables
# Copy this file to `.env` and fill in the values.
# OCR/AI/Queue values are OPTIONAL.
# When unset - fallback to current local behavior.
# ------------------------------------------------------------

# Required

# Node environment
NODE_ENV=development

# Server
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meditrack_db?schema=public"

# JWT Secret (generate secure value)
JWT_SECRET=

# Auth Configuration

JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing
BCRYPT_ROUNDS=12

# Frontend / API

FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Proxy
TRUST_PROXY=0

# Upload size
MAX_UPLOAD_SIZE_MB=5

# Enable swagger if required
# SWAGGER_ENABLED=true


# ------------------------------------------------------------
# OCR Sidecar (OpenCV + PP-OCRv6)
# Keep the token identical in the API and OCR service. In local non-Docker
# development, set OCR_ALLOW_TESSERACT_FALLBACK=true only as a temporary fallback.
# ------------------------------------------------------------
OCR_SERVICE_URL="http://localhost:8000"
OCR_SERVICE_TOKEN="replace-with-a-long-random-ocr-service-token"
PADDLE_ENABLE_MKLDNN=false
OCR_HTTP_TIMEOUT_MS=135000
OCR_ALLOW_TESSERACT_FALLBACK=true
PRESCRIPTION_VISION_MODE=auto


# ------------------------------------------------------------
# Ollama Local LLM
# Leave unset - regex extraction only
# ------------------------------------------------------------
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:7b-instruct"

# ------------------------------------------------------------
# Patient companion AI providers
# Groq is preferred in cloud; Ollama remains an optional local fallback.
# Never expose GROQ_API_KEY through a VITE_ variable.
# ------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3-32b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
AI_PROVIDER_ORDER="groq,ollama"
AI_REQUEST_TIMEOUT_MS=15000


# ------------------------------------------------------------
# BullMQ / Redis
# Leave unset - synchronous processing
# ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# ------------------------------------------------------------
# OCR hardening / performance budgets
# ------------------------------------------------------------
OCR_MAX_IMAGE_DIMENSION=2600
OCR_MAX_IMAGE_PIXELS=25000000
OCR_VARIANT_TIMEOUT_MS=8000
OCR_CACHE_TTL_MS=86400000
OCR_CACHE_MAX_ENTRIES=250
OCR_CACHE_VERSION=ocr-evidence-v2

# Candidate generation bounds. Regex and Dictionary still scan all evidence;
# these settings only bound local-LLM context and latency.
CANDIDATE_LLM_MAX_LINES=48
CANDIDATE_LLM_CHUNK_LINES=12
CANDIDATE_LLM_TIMEOUT_MS=30000
CANDIDATE_DETERMINISTIC_TIMEOUT_MS=5000

# Synchronous upload budget. For production, move OCR to a queue and return a
# job id instead of increasing this indefinitely.
PRESCRIPTION_SYNC_BUDGET_MS=60000
MEDICINE_VERIFICATION_MAX_CALLS=5
MEDICINE_VERIFICATION_TIMEOUT_MS=15000
VERIFICATION_CACHE_ENABLED=true
VERIFICATION_CACHE_MAX_SIZE=1000
VERIFICATION_CACHE_TTL_MS=86400000

# Optional: free openFDA key for clinical label enrichment.
OPENFDA_API_KEY=

# Trusted web-source assist for admin clinical reviews
# Used only by admin review flow; patients never receive raw web answers.
TAVILY_API_KEY=
WEB_SOURCE_SEARCH_DEPTH=advanced
WEB_SOURCE_SEARCH_COUNTRY=india
WEB_SOURCE_SEARCH_MAX_RESULTS=8
WEB_SOURCE_ASSIST_CACHE_TTL_MS=604800000
# Phone/SMS notifications for registered numbers
# Disabled by default. Use console for local smoke tests, twilio/generic-webhook for real delivery.
PHONE_NOTIFICATIONS_ENABLED=false
PHONE_NOTIFICATION_PROVIDER=console
PHONE_NOTIFICATION_DEFAULT_COUNTRY_CODE=+91
PHONE_NOTIFICATION_INCLUDE_MEDICINE_NAME=false
PHONE_NOTIFICATION_REQUIRE_VERIFIED_USER=false

# Twilio provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Generic webhook provider for MSG91/Fast2SMS/custom gateways
PHONE_NOTIFICATION_WEBHOOK_URL=
PHONE_NOTIFICATION_WEBHOOK_API_KEY=

# ------------------------------------------------------------
# Account email verification
# Production supports Brevo or authenticated SMTP. Console delivery is
# development-only and prints the link locally.
# Gmail SMTP: use a Google App Password, never the account password.
# ------------------------------------------------------------
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_PROVIDER=console
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="MediTrack AI"
EMAIL_NOTIFICATIONS_ENABLED=false
