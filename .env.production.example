# Copy to a secret-managed production environment. Never commit real values.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-48-character-random-secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
LOG_LEVEL=info
TRUST_PROXY=1
MAX_UPLOAD_SIZE_MB=10
OCR_SERVICE_URL=https://ocr.example.com
OCR_SERVICE_TOKEN=replace-with-a-long-random-ocr-service-token
PADDLE_ENABLE_MKLDNN=false
OCR_HTTP_TIMEOUT_MS=135000
OCR_ALLOW_TESSERACT_FALLBACK=false
PRESCRIPTION_VISION_MODE=sidecar
MEDICAL_FILE_STORAGE=private-object
MEDICAL_FILE_STORAGE_BUCKET=meditrack-medical-files
UPLOADS_VOLUME_PATH=
ALLOW_DEMO_EPHEMERAL_MEDICAL_UPLOADS=false
OPENFDA_API_KEY=
TAVILY_API_KEY=
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_PROVIDER=brevo
BREVO_API_KEY=
# Alternative personal-mail SMTP configuration:
# EMAIL_VERIFICATION_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password-without-spaces
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=verified-sender@example.com
EMAIL_FROM_NAME="MediTrack AI"
EMAIL_NOTIFICATIONS_ENABLED=false
PHONE_NOTIFICATIONS_ENABLED=false
PHONE_NOTIFICATION_PROVIDER=twilio
PHONE_NOTIFICATION_DEFAULT_COUNTRY_CODE=+91
PHONE_NOTIFICATION_INCLUDE_MEDICINE_NAME=false
PHONE_NOTIFICATION_REQUIRE_VERIFIED_USER=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_NOTIFICATION_WEBHOOK_URL=
PHONE_NOTIFICATION_WEBHOOK_API_KEY=
ANDROID_KEYSTORE_PATH=C:/secure/meditrack-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=meditrack-release
ANDROID_KEY_PASSWORD=
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
GIT_COMMIT_SHA=replace-with-release-commit-sha
VITE_API_URL=https://api.example.com/api
VITE_ENABLE_DEVTOOLS=false
