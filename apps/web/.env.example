# ─────────────────────────────────────────────────────────
# MediTrack AI — Frontend + Backend Environment
# ─────────────────────────────────────────────────────────

# =========================
# FRONTEND (VITE)
# =========================
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=MediTrack AI
VITE_ENABLE_DEVTOOLS=true

# =========================
# BACKEND CORE
# =========================
DATABASE_URL="postgresql://user:password@localhost:5432/meditrack?schema=public"
JWT_SECRET="change-me"
PORT=3000

# =========================
# OCR PIPELINE (Python Sidecar)
# =========================
# Enables PaddleOCR + OpenCV preprocessing pipeline
OCR_SERVICE_URL="http://localhost:8000"

# =========================
# LOCAL LLM (Ollama)
# =========================
# Used for structured medical extraction (JSON output)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:7b-instruct"

# =========================
# ASYNC PIPELINE (BullMQ)
# =========================
# Enables background OCR + extraction processing
REDIS_URL="redis://localhost:6379"
