model WebSourceAssistCache {
  id            String      @id @default(cuid())
  saltProfileId String
  saltProfile   SaltProfile @relation(fields: [saltProfileId], references: [id], onDelete: Cascade)
  query         String
  queryHash     String      @unique
  provider      String      @default("Tavily")
  status        String      @default("SUCCESS")
  result        Json
  sourceCount   Int         @default(0)
  evidenceCount Int         @default(0)
  draftedFields Json?
  warnings      Json?
  lastError     String?
  searchedAt    DateTime    @default(now())
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([saltProfileId, searchedAt])
  @@index([saltProfileId, expiresAt])
  @@index([status, searchedAt])
  @@map("web_source_assist_cache")
}

model PatientExplanation {
  id                  String                   @id @default(cuid())
  saltProfileId       String
  saltProfile         SaltProfile              @relation(fields: [saltProfileId], references: [id], onDelete: Cascade)
  language            String                   @default("en")
  whyPrescribed       String?
  howToTake           String?
  sideEffects         Json?
  warnings            String?
  storage             String?
  sourceRefs          Json?
  unsafeOmittedFields Json?
  status              PatientExplanationStatus @default(NEEDS_SOURCE)
  generatedBy         String?
  modelVersion        String?
  reviewedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([saltProfileId, language])
  @@index([language, status])
  @@index([status, updatedAt])
  @@map("patient_explanations")
}

model MedicinePackage {
  id              String                 @id @default(cuid())
  medicineId      String
  medicine        MedicineMaster         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  gtin            String?                @unique
  barcodeType     String?
  packSize        String?
  stripImageUrl   String?
  pillImageUrl    String?
  mrpPrice        Decimal?               @db.Decimal(10, 2)
  priceCurrency   String                 @default("INR")
  priceSource     String?
  priceLastSeenAt DateTime?
  isDemo          Boolean                @default(false)
  isVerified      Boolean                @default(false)
  source          RecordSource           @default(IMPORT)
  verifiedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  userMedicines   Medicine[]
  purchaseLinks   MedicinePurchaseLink[]
  reviewItems     MedicineDataReview[]

  @@index([medicineId])
  @@index([gtin])
  @@index([isDemo])
  @@map("medicine_packages")
}

model MedicinePurchaseLink {
  id                String           @id @default(cuid())
  medicineMasterId  String
  medicineMaster    MedicineMaster   @relation(fields: [medicineMasterId], references: [id], onDelete: Cascade)
  medicinePackageId String?
  medicinePackage   MedicinePackage? @relation(fields: [medicinePackageId], references: [id], onDelete: SetNull)
  provider          String
  productUrl        String
  providerProductId String?
  isVerified        Boolean          @default(false)
  isActive          Boolean          @default(true)
  source            RecordSource     @default(IMPORT)
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, productUrl])
  @@index([medicineMasterId, isActive, isVerified])
  @@index([medicinePackageId, isActive, isVerified])
  @@index([provider, providerProductId])
  @@map("medicine_purchase_links")
}

model MedicineDataReview {
  id                String               @id @default(cuid())
  type              MedicineReviewType
  status            MedicineReviewStatus @default(OPEN)
  submittedById     String?
  reviewedById      String?
  medicineMasterId  String?
  medicinePackageId String?
  saltProfileId     String?
  normalizedKey     String?              @unique
  source            MedSource?
  strength          String?
  form              MedicineForm?
  rawName           String?
  gtin              String?
  userStripImageUrl String?
  billLine          String?
  demandCount       Int                  @default(1)
  payload           Json?
  notes             String?
  adminNotes        String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  submittedBy     User?            @relation("MedicineReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("MedicineReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  medicineMaster  MedicineMaster?  @relation(fields: [medicineMasterId], references: [id], onDelete: SetNull)
  medicinePackage MedicinePackage? @relation(fields: [medicinePackageId], references: [id], onDelete: SetNull)
  saltProfile     SaltProfile?     @relation(fields: [saltProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, status])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([medicineMasterId])
  @@index([medicinePackageId])
  @@index([saltProfileId])
  @@index([normalizedKey])
  @@index([source, status])
  @@index([gtin])
  @@map("medicine_data_reviews")
}

model MedicineImportBatch {
  id               String                     @id @default(cuid())
  uploadedById     String?
  uploadedBy       User?                      @relation("MedicineImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  originalFileName String?
  storedPath       String?
  datasetName      String?
  datasetVersion   String?
  source           RecordSource               @default(IMPORT)
  status           MedicineImportStatus       @default(STAGED)
  totalRows        Int                        @default(0)
  validRows        Int                        @default(0)
  invalidRows      Int                        @default(0)
  duplicateRows    Int                        @default(0)
  createRows       Int                        @default(0)
  updateRows       Int                        @default(0)
  saltsToCreate    Int                        @default(0)
  saltsToReuse     Int                        @default(0)
  committedRows    Int                        @default(0)
  skippedRows      Int                        @default(0)
  report           Json?
  committedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  rows             MedicineImportStagingRow[]

  @@index([uploadedById])
  @@index([status, createdAt])
  @@map("medicine_import_batches")
}

model MedicineImportStagingRow {
  id                        String                  @id @default(cuid())
  importBatchId             String
  importBatch               MedicineImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber                 Int
  action                    MedicineImportRowAction @default(INVALID)
  raw                       Json
  normalized                Json?
  brandName                 String?
  normalizedName            String?
  genericName               String?
  composition               String?
  manufacturer              String?
  strength                  String?
  type                      String?
  isDiscontinued            Boolean                 @default(false)
  prescriptionRequired      Boolean?
  packSize                  String?
  gtin                      String?
  stripImageUrl             String?
  pillImageUrl              String?
  mrpPrice                  Decimal?                @db.Decimal(10, 2)
  priceCurrency             String?
  priceSource               String?
  saltKey                   String?
  saltDisplayName           String?
  ingredients               Json?
  dedupeKey                 String?
  validationErrors          String[]                @default([])
  warnings                  String[]                @default([])
  duplicateInFile           Boolean                 @default(false)
  existingMedicineMasterId  String?
  existingSaltProfileId     String?
  committedMedicineMasterId String?
  committedSaltProfileId    String?
  committedPackageId        String?
  committedAt               DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, action])
  @@index([importBatchId, dedupeKey])
  @@index([importBatchId, saltKey])
  @@map("medicine_import_staging_rows")
}

