model MedicineMaster {
  id                   String                 @id @default(cuid())
  brandName            String
  normalizedName       String?
  genericName          String?
  composition          String?
  salts                Json?
  category             String?
  manufacturer         String?
  strength             String?
  type                 String?
  isDiscontinued       Boolean                @default(false)
  prescriptionRequired Boolean?
  saltProfileId        String?
  saltProfile          SaltProfile?           @relation(fields: [saltProfileId], references: [id])
  brandOverride        Json?
  source               RecordSource           @default(IMPORT)
  isVerified           Boolean                @default(false)
  isArchived           Boolean                @default(false)
  version              Int                    @default(1)
  dedupeKey            String                 @unique
  mergedIntoId         String?
  mergedInto           MedicineMaster?        @relation("MedicineMasterMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom           MedicineMaster[]       @relation("MedicineMasterMerge")
  mergedAt             DateTime?
  mergeReason          String?
  packages             MedicinePackage[]
  purchaseLinks        MedicinePurchaseLink[]
  reviewItems          MedicineDataReview[]
  userMedicines        Medicine[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([brandName])
  @@index([normalizedName])
  @@index([composition])
  @@index([saltProfileId])
  @@index([isArchived])
  @@index([isDiscontinued])
  @@index([prescriptionRequired])
  @@index([mergedIntoId])
  @@map("medicine_masters")
}

model SaltProfile {
  id                      String                 @id @default(cuid())
  saltKey                 String                 @unique
  displayName             String
  ingredients             Json
  uses                    String?
  howToTake               String?
  whenToTake              String?
  sideEffects             Json?
  warnings                String?
  substitutes             Json?
  storage                 String?
  sourceRefs              Json?
  enrichmentStatus        EnrichmentStatus       @default(NEEDS_SOURCE)
  lastEnrichmentAttemptAt DateTime?
  lastEnrichmentSuccessAt DateTime?
  lastEnrichmentError     String?
  source                  RecordSource           @default(IMPORT)
  isVerified              Boolean                @default(false)
  version                 Int                    @default(1)
  language                String                 @default("en")
  brands                  MedicineMaster[]
  patientExplanations     PatientExplanation[]
  detailRequests          MedicineDataReview[]
  webSourceAssistCaches   WebSourceAssistCache[]
  allergyIntolerances     AllergyIntolerance[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([saltKey])
  @@index([enrichmentStatus, lastEnrichmentAttemptAt])
  @@map("salt_profiles")
}

model PatientSafetyProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  pregnancyStatus    SafetyConditionStatus    @default(UNKNOWN)
  kidneyCondition    SafetyConditionStatus    @default(UNKNOWN)
  liverCondition     SafetyConditionStatus    @default(UNKNOWN)
  source             SafetyRecordSource       @default(PATIENT_REPORTED)
  verificationStatus SafetyVerificationStatus @default(UNVERIFIED)
  lastReviewedAt     DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_safety_profiles")
}

model AllergyIntolerance {
  id                  String                   @id @default(cuid())
  userId              String
  saltProfileId       String?
  substanceRaw        String
  normalizedSubstance String
  category            AllergyCategory          @default(ALLERGY)
  criticality         AllergyCriticality       @default(UNABLE_TO_ASSESS)
  reaction            String?
  clinicalStatus      AllergyClinicalStatus    @default(ACTIVE)
  verificationStatus  SafetyVerificationStatus @default(UNVERIFIED)
  source              SafetyRecordSource       @default(PATIENT_REPORTED)
  verifiedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saltProfile         SaltProfile?             @relation(fields: [saltProfileId], references: [id], onDelete: SetNull)

  @@index([userId, clinicalStatus])
  @@index([userId, normalizedSubstance])
  @@index([saltProfileId])
  @@map("allergy_intolerances")
}

model MedicationSafetyFinding {
  id                 String                            @id @default(cuid())
  userId             String
  fingerprint        String                            @unique
  rule               MedicationSafetyRule
  severity           MedicationSafetySeverity
  status             MedicationSafetyFindingStatus     @default(OPEN)
  title              String
  summary            String
  triggerIngredients Json
  evidence           Json
  sourceRefs         Json?
  firstDetectedAt    DateTime                          @default(now())
  lastDetectedAt     DateTime                          @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  resolutionReason   String?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  user               User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicines          MedicationSafetyFindingMedicine[]

  @@index([userId, status, severity])
  @@index([userId, rule])
  @@map("medication_safety_findings")
}

model MedicationSafetyFindingMedicine {
  findingId  String
  medicineId String
  finding    MedicationSafetyFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  medicine   Medicine                @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([findingId, medicineId])
  @@index([medicineId])
  @@map("medication_safety_finding_medicines")
}

