{
  "name": "api-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --testPathIgnorePatterns=evaluation",
    "test:slow": "jest --runInBand --testPathPattern=evaluation",
    "benchmark:recall": "node scratch/run_recall_benchmark.js",
    "seed:demo": "ts-node --project tsconfig.json tools/seed-demo-patient.ts",
    "import:medicines": "ts-node --project tsconfig.json tools/import-medicines.ts",
    "import:purchase-links": "ts-node --project tsconfig.json tools/import-purchase-links.ts",
    "enrich:salts": "ts-node --project tsconfig.json tools/enrich-salts.ts",
    "index:dailymed": "ts-node --project tsconfig.json tools/index-dailymed.ts",
    "explain:patients": "ts-node --project tsconfig.json tools/generate-patient-explanations.ts",
    "merge:medicine-masters": "ts-node --project tsconfig.json tools/merge-medicine-masters.ts",
    "repair:package-capture": "ts-node --project tsconfig.json tools/repair-package-capture.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "admin:promote": "ts-node --project tsconfig.json tools/promote-admin.ts",
    "email:check": "node tools/check-verification-email.mjs",
    "validate:production": "node tools/validate-production-env.mjs --require-android-signing",
    "verify:ci": "node tools/verify-release.mjs --ci",
    "verify:release": "node tools/verify-release.mjs",
    "smoke:production": "node tools/smoke-production.mjs",
    "smoke:production:auth": "node tools/smoke-production-authenticated.mjs",
    "smoke:ocr": "node tools/smoke-ocr-capture.mjs",
    "smoke:bill:local": "node tools/smoke-local-bill.mjs",
    "smoke:package:local": "node tools/smoke-local-package.mjs",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint:ratchet": "node tools/lint-ratchet.mjs --project=backend",
    "lint:baseline": "node tools/lint-ratchet.mjs --project=backend --write-baseline"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "axios": "1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4",
    "dotenv": "^17.4.1",
    "form-data": "^4.0.6",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!uuid)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "deepmerge-ts": "8.0.1",
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  }
}
